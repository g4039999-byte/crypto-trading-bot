@echo off
chcp 65001 >nul
title بوت التداول - لوحة التحكم
cd /d "%~dp0"

echo ==========================================
echo    تشغيل لوحة تحكم بوت التداول
echo ==========================================
echo.

if not exist ".venv\Scripts\python.exe" (
    echo تعذر إيجاد بيئة Python في .venv
    echo تأكد أنك تشغل هذا الملف من داخل مجلد المشروع.
    pause
    exit /b 1
)

rem تحقّق أولًا هل الواجهة تعمل بالفعل على المنفذ 5000 -- إن كانت تعمل
rem فلا داعي لتشغيل نسخة ثانية (وهذا ما كان يسبب تعليق الأزرار سابقًا)،
rem بل نكتفي بفتح المتصفح على النسخة القائمة فعلاً.
netstat -ano | findstr ":5000 " | findstr "LISTENING" >nul 2>&1
if %errorlevel%==0 (
    echo الواجهة تعمل بالفعل على المنفذ 5000.
    echo سيتم فتح المتصفح على النسخة الحالية دون تشغيل نسخة جديدة.
    start "" http://127.0.0.1:5000
    echo.
    echo يمكنك إغلاق هذه النافذة الآن.
    pause
    exit /b 0
)

echo سيتم فتح المتصفح تلقائيًا خلال ثوانٍ...
start "" http://127.0.0.1:5000

".venv\Scripts\python.exe" -m webapp.app

echo.
echo تم إيقاف لوحة التحكم. يمكنك إغلاق هذه النافذة.
pause
