.venv/
.env
__pycache__/
*.pyc

# Live-trading runtime state -- regenerated locally, never meant to be
# shared via git, and never contains secrets (no keys, no seed phrases).
data/positions.json
data/trade_log.jsonl
data/STOP_TRADING

# Paper-trading runtime state -- same reasoning, entirely separate from
# the (still unused) live-trading files above.
data/paper_positions.json
data/paper_trade_log.jsonl

# Radar observation runtime state -- rewritten every radar cycle by any
# running `python -m src.radar --loop` process, so it changes constantly
# and adds no real history to git. Same reasoning as the runtime state
# above; never contains secrets.
data/snapshots.json
data/opportunity_watchlist.json

# webapp/ runtime state -- the PID of the paper-radar process the web
# control panel is currently managing. Local-machine-only, regenerated
# every Start/Stop, never contains secrets.
data/webapp_radar.pid

# scripts/strategy_registry.py's recorded backtest history -- derived
# from this machine's own data/snapshots.json, so it's local analysis
# output (like the runtime state above), not source. Regenerate with
# `python -m scripts.strategy_registry record <preset>`.
data/strategy_versions.json

# X (Twitter) social-intelligence runtime state -- src/x_intelligence.py
# and friends. Local-machine-only, regenerated as the radar polls (if
# X_BEARER_TOKEN is even configured -- it isn't, by default), never
# contains secrets (the token itself lives only in .env, already
# ignored above).
data/x_signals.json
data/x_account_reputation.json
data/x_usage.json
data/x_poll_state.json
