# Copy this file to .env and adjust as needed.
# .env is already git-ignored -- never commit real secrets.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Filtering thresholds (radar's first-pass filter) ---
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H_USD=25000
MIN_BUY_SELL_RATIO=0.8
MAX_SELL_BUY_RATIO=3.0

# --- Networking ---
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=3
REQUEST_RETRY_BACKOFF_SECONDS=1.5
MAX_ADDRESSES_PER_REQUEST=30

# --- Snapshots ---
SNAPSHOT_HISTORY_LIMIT=60

# Reserved for future use. DexScreener's public endpoints do not currently
# require a key -- leave this empty unless that changes.
DEXSCREENER_API_KEY=


# =============================================================================
# LIVE TRADING -- read src/config.py and src/wallet.py before touching this.
# Everything below defaults to the safest possible state. LIVE_TRADING=false
# is the only value that has ever been tested or run.
# =============================================================================

# Master switch. Do not set to true without also reading README.md's
# "Live trading" section in full.
LIVE_TRADING=false

# Must equal I_UNDERSTAND_AND_APPROVE_LIVE_TRADING exactly, or real
# execution stays blocked even if LIVE_TRADING=true. Leave empty.
CONFIRM_LIVE_TRADING=

# Immediate kill switch: if this file exists, no new trade is placed.
# Create it by hand at any time with: touch data/STOP_TRADING
KILL_SWITCH_FILE=data/STOP_TRADING

# --- Capital & position sizing -- keep TOTAL_CAPITAL_USD true to your
# real wallet balance; update it whenever that balance changes. ---
TOTAL_CAPITAL_USD=24
MAX_TRADE_USD=5
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PCT=20
MAX_CAPITAL_DEPLOYMENT_PCT=80

# --- Exit rules ---
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=50

# --- Execution safety ---
MAX_SLIPPAGE_BPS=300

# --- Entry screening (stricter than the discovery filter above) ---
MIN_LIVE_SCORE=80
MIN_LIVE_LIQUIDITY_USD=15000
MIN_LIVE_VOLUME_24H_USD=50000
MIN_LIVE_PAIR_AGE_MINUTES=5
MAX_LIVE_PAIR_AGE_MINUTES=180
SELLABILITY_PROBE_SOL=0.01
MAX_ROUND_TRIP_LOSS_PCT=20

# --- Wallet & RPC ---
# SOLANA_WALLET_PUBLIC_KEY is your address, not secret -- fine to fill in
# for read-only balance/connection checks even before you're ready to
# configure a private key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_PUBLIC_KEY=

# SOLANA_PRIVATE_KEY is a SECRET. Never commit it, never paste it into a
# chat (including with an AI assistant), never share it. Leave this
# empty unless you are running the bot yourself, locally, from a .env
# file that stays only on your machine.
SOLANA_PRIVATE_KEY=
