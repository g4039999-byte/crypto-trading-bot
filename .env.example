# Copy this file to .env and adjust as needed.
# .env is already git-ignored -- never commit real secrets.

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Filtering thresholds (radar's first-pass filter) ---
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_24H_USD=25000
MIN_BUY_SELL_RATIO=0.8
MAX_SELL_BUY_RATIO=3.0

# --- Networking ---
REQUEST_TIMEOUT_SECONDS=10
REQUEST_MAX_RETRIES=3
REQUEST_RETRY_BACKOFF_SECONDS=1.5
MAX_ADDRESSES_PER_REQUEST=30

# --- Snapshots ---
SNAPSHOT_HISTORY_LIMIT=60

# --- Continuous mode / watchlist ---
# How many previously-seen tokens to keep re-checking each cycle (0 = off).
RADAR_WATCHLIST_SIZE=100
# Seconds between cycles in `python -m src.radar --loop` (overridable with --interval).
# 60s: a token needs 2 cycles of snapshots before observation.py can report
# a real trend at all, so a slower interval directly delays how early a
# genuinely new token can ever qualify for entry.
RADAR_LOOP_INTERVAL_SECONDS=60

# Reserved for future use. DexScreener's public endpoints do not currently
# require a key -- leave this empty unless that changes.
DEXSCREENER_API_KEY=

# Optional SECOND discovery feed (src/pumpfun_client.py): newly-created
# Pump.fun token addresses, via Solana Tracker's Data API (Pump.fun has
# no free/official discovery API of its own) -- a free key covers 2500
# requests/month: https://docs.solanatracker.io/data-api. Purely
# additive to DexScreener's own feed -- leaving this empty costs nothing
# and makes zero extra network calls; radar.py runs exactly as before.
PUMPFUN_API_KEY=
PUMPFUN_ENABLED=true
# How many recent Pump.fun launches to request per radar cycle.
PUMPFUN_DISCOVERY_LIMIT=50


# =============================================================================
# LIVE TRADING -- read src/config.py and src/wallet.py before touching this.
# Everything below defaults to the safest possible state. LIVE_TRADING=false
# is the only value that has ever been tested or run.
# =============================================================================

# Master switch. Do not set to true without also reading README.md's
# "Live trading" section in full.
LIVE_TRADING=false

# Must equal I_UNDERSTAND_AND_APPROVE_LIVE_TRADING exactly, or real
# execution stays blocked even if LIVE_TRADING=true. Leave empty.
CONFIRM_LIVE_TRADING=

# Immediate kill switch: if this file exists, no new trade is placed.
# Create it by hand at any time with: touch data/STOP_TRADING
KILL_SWITCH_FILE=data/STOP_TRADING

# --- Capital & position sizing -- keep TOTAL_CAPITAL_USD true to your
# real wallet balance; update it whenever that balance changes. ---
TOTAL_CAPITAL_USD=24
MAX_TRADE_USD=5
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PCT=20
MAX_CAPITAL_DEPLOYMENT_PCT=80

# --- Exit rules ---
STOP_LOSS_PCT=25
TAKE_PROFIT_PCT=50
# Close a position after this long regardless of price, so every trade
# reaches a decision instead of being held indefinitely.
MAX_HOLDING_MINUTES=240

# --- Execution safety ---
MAX_SLIPPAGE_BPS=300

# --- Entry screening (stricter than the discovery filter above) ---
MIN_LIVE_SCORE=80
MIN_LIVE_LIQUIDITY_USD=15000
MIN_LIVE_VOLUME_24H_USD=50000
MIN_LIVE_PAIR_AGE_MINUTES=5
MAX_LIVE_PAIR_AGE_MINUTES=180
SELLABILITY_PROBE_SOL=0.01
MAX_ROUND_TRIP_LOSS_PCT=20

# --- Paper-trading entry tuning (src/paper_trader.py) -- deliberately
# more permissive than MIN_LIVE_* above so simulated trading actually
# trades; every safety check (liquidity/volume floor, rug-window age,
# honeypot/sellability) still applies in full. See src/config.py for the
# full reasoning. Live trading is completely unaffected by these. ---
PAPER_MIN_SCORE=40
PAPER_ENTRY_TRENDS=STRONG,RISING,NEUTRAL
# STRONG/RISING (a short-term buy-flow-delta trend, not the same as the
# cumulative buy_ratio baked into the score) additionally need this
# higher score before being allowed to enter -- NEUTRAL keeps using
# PAPER_MIN_SCORE alone. Backtested against real data (scripts/
# diagnose_paper_strategy.py + scripts/backtest_paper_strategy.py) --
# see src/config.py for the full evidence this was validated against.
PAPER_ELEVATED_TREND_MIN_SCORE=55
# Round 2: skip a token for this many minutes after it's been seen
# moving faster than this %/minute (since its own first radar
# snapshot) -- a temporary delay, not a permanent reject. See
# src/config.py for the backtest evidence (fold_stability 0.5->0.75,
# confirmed across every walk-forward fold count and two out-of-sample
# cutoffs, not just one comparison).
PAPER_VELOCITY_SPIKE_THRESHOLD_PCT_PER_MIN=5.0
PAPER_VELOCITY_SPIKE_COOLDOWN_MINUTES=30
PAPER_MIN_LIQUIDITY_USD=5000
PAPER_MIN_VOLUME_24H_USD=25000
# 15m, not MIN_LIVE_PAIR_AGE_MINUTES=5m -- backtested against 161 real
# tokens/~7000 snapshots (scripts/backtest_paper_strategy.py): entries
# right at a 5m floor were disproportionately early-life pump-then-dump
# losers; the same candidates a bit older performed far better.
PAPER_MIN_PAIR_AGE_MINUTES=15
PAPER_MAX_PAIR_AGE_MINUTES=180
# Paper trading can hold more than one position at once (real risk is
# zero) -- unlike live's MAX_OPEN_POSITIONS=1 above.
PAPER_MAX_OPEN_POSITIONS=3

# --- Paper-only exit tuning -- kept separate from the shared STOP_LOSS_
# PCT/TAKE_PROFIT_PCT above so live's numbers are never touched by this.
# Same backtest as above: a tighter take-profit locks in gains before
# these thin-liquidity tokens give them back (CURRENT rules: -$21.99
# over 20 trades/20% win rate; CANDIDATE rules incl. these two: +$8.12
# over 7 trades/85.7% win rate, on the exact same historical data).
PAPER_STOP_LOSS_PCT=25
PAPER_TAKE_PROFIT_PCT=25
# Reject a candidate whose liquidity has already fallen this much from
# its own recent peak, even if what's left still clears PAPER_MIN_
# LIQUIDITY_USD -- a level "still above the floor" can hide a pool
# actively being drained (both real closing losses on 2026-09-03 had
# already lost >50% of peak liquidity by the time they were bought).
PAPER_MAX_LIQUIDITY_DRAWDOWN_PCT=40
# Do not re-buy a token for this long after a stop-loss on it (observed
# live: a token was stopped out, bought again 5 minutes later while
# still falling, and lost a second time). 0 disables the cooldown.
PAPER_STOP_LOSS_COOLDOWN_MINUTES=60

# --- Jupiter aggregator (public "lite" tier, no key required) ---
# quote-api.jup.ag (V6) was deprecated 2025-10-01 and no longer resolves.
# lite-api.jup.ag is Jupiter's current free tier of the same Swap API --
# only override these if Jupiter migrates endpoints again.
JUPITER_QUOTE_URL=https://lite-api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL=https://lite-api.jup.ag/swap/v1/swap

# --- Wallet & RPC ---
# SOLANA_WALLET_PUBLIC_KEY is your address, not secret -- fine to fill in
# for read-only balance/connection checks even before you're ready to
# configure a private key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_PUBLIC_KEY=

# SOLANA_PRIVATE_KEY is a SECRET. Never commit it, never paste it into a
# chat (including with an AI assistant), never share it. Leave this
# empty unless you are running the bot yourself, locally, from a .env
# file that stays only on your machine.
SOLANA_PRIVATE_KEY=

# =============================================================================
# X (Twitter) social intelligence -- OPTIONAL, additive, OFF by default.
# As of 2026 X's API has no free tier for a new project: reads are
# billed pay-per-use (~$0.005/post) or via a legacy $200+/month
# subscription. Leaving X_BEARER_TOKEN empty costs nothing and makes
# zero network calls -- radar/paper trading work exactly the same
# without it. See src/config.py's X_* block for the full reasoning.
# =============================================================================

# X_BEARER_TOKEN is a SECRET -- same rules as SOLANA_PRIVATE_KEY above.
X_BEARER_TOKEN=
X_ENABLED=true
# Hard daily spending guard, in number of post-reads (~$0.005 each at
# pay-per-use rates). Raise this deliberately, knowing the real cost.
X_MAX_READS_PER_DAY=500
X_POLL_INTERVAL_SECONDS=300
X_MAX_RESULTS_PER_QUERY=30
X_SEARCH_QUERIES=solana meme coin,new solana gem,$SOL pump,solana launch
X_MIN_INDEPENDENT_MENTIONS=2
X_SIGNAL_TTL_MINUTES=60
# Max points an X signal can add to a token's score -- additive only,
# never a gate; a token with no X signal scores exactly as before.
X_SCORE_MAX_BONUS=10
X_CLONE_SYMBOL_SIMILARITY_THRESHOLD=0.8

# =============================================================================
# US STOCKS (src/stocks/) -- separate paper-trading subsystem, entirely
# isolated from everything above (own config, own state files, own web
# UI section). Leaving ALPACA_API_KEY/ALPACA_API_SECRET empty costs
# nothing and makes zero network calls to Alpaca -- src/stocks/
# data_provider.py automatically uses yfinance (free, no account needed)
# instead, so the whole subsystem runs with zero configuration below.
# =============================================================================

# ALPACA_API_KEY / ALPACA_API_SECRET are SECRETS -- same rules as
# SOLANA_PRIVATE_KEY above: never commit them, never paste them into a
# chat (including with an AI assistant). Generate a PAPER-account key
# pair at https://app.alpaca.markets (paper trading is free). These are
# ONLY ever used against Alpaca's paper endpoint
# (https://paper-api.alpaca.markets) by src/stocks/alpaca_client.py.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_ENABLED=true
# "auto" = Alpaca if the two keys above are set, else yfinance. Force a
# specific source with "alpaca" or "yfinance".
STOCKS_DATA_PROVIDER=auto

# --- Stocks LIVE trading gate -- three independent layers, all default
# closed. See STOCKS_LIVE_TRADING_GATE.md before ever touching any of
# these. Layer 1 (STOCKS_EXECUTION_ENABLED_IN_CODE) is NOT an env var at
# all -- it is a hardcoded constant in src/stocks/live_broker.py that
# only a source-code edit can flip; nothing here can enable it. Even
# with every value below set, real order execution stays blocked until
# that source line is also deliberately changed. ---
STOCKS_LIVE_TRADING=false
# Must equal I_UNDERSTAND_AND_APPROVE_STOCKS_LIVE_TRADING exactly, or
# real stocks execution stays blocked even if STOCKS_LIVE_TRADING=true.
# Leave empty.
STOCKS_CONFIRM_LIVE_TRADING=
# ALPACA_LIVE_API_KEY / ALPACA_LIVE_API_SECRET are SECRETS, and are a
# SEPARATE key pair from ALPACA_API_KEY/ALPACA_API_SECRET above --
# Alpaca issues different keys for its paper and live environments.
# Only ever read by src/stocks/live_broker.py, and only after all three
# gate layers pass. Leave empty.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=
